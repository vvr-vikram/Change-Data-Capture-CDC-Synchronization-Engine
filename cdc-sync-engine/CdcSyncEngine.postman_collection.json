{
  "info": {
    "_postman_id": "4b68e9be-e75c-4396-857c-65824c13a4cd",
    "name": "Change Data Capture (CDC) Sync Engine API",
    "description": "API collection for managing the CDC Sync Engine including Authentication, Sync Status, Auditing, and DLT Failure Replays.",
